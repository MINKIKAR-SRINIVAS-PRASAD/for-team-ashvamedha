# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers).
# URL-encode special characters in the database password. Never commit your real .env.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ashvamedha2026

# Security: replace both with strong random values before deploying.
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_EXPIRE_HOURS=12

# First admin is created on first boot only if the users collection is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional sport coordinators: sport-slug:username:password;another-slug:username:password
SPORT_ADMINS=

# Frontend origins allowed to call the backend (comma-separated).
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000

UPI_ID=
UPI_PAYEE_NAME=ASHVAMEDHA IIT Bhubaneswar

AUTO_SEED=true
# Set true only when the organisers officially reopen public registration.
REGISTRATIONS_OPEN=false
SEED_DEMO_MATCHES=false
POINTS_WIN=3
POINTS_DRAW=1
POINTS_LOSS=0
MEDIA_DIR=media
MAX_UPLOAD_MB=5
