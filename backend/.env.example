# ── Database ─────────────────────────────────────────────
# Local dev: SQLite file, zero setup.
DATABASE_URL=sqlite:///./ashvamedha.db
# Production (Neon / Supabase / Render Postgres):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# ── Security ─────────────────────────────────────────────
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_EXPIRE_HOURS=12

# First admin account (created automatically if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345

# ── Frontend / CORS ──────────────────────────────────────
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Public URL of this API (used to build uploaded image URLs)
PUBLIC_BASE_URL=http://localhost:8000

# ── Registration payments (shown on the registration form) ─
UPI_ID=
UPI_PAYEE_NAME=ASHVAMEDHA IIT Bhubaneswar

# ── Behaviour ────────────────────────────────────────────
# Load the frontend's current content into an empty database on startup
AUTO_SEED=true
# Standings points
POINTS_WIN=3
POINTS_DRAW=1
POINTS_LOSS=0
